-- Add cumulative read duration to mangas so stats survive history deletion
ALTER TABLE mangas ADD COLUMN total_read_duration INTEGER NOT NULL DEFAULT 0;

-- One-time init: seed the column from existing history so existing users don't lose their stats
UPDATE mangas
SET total_read_duration = (
    SELECT coalesce(sum(H.time_read), 0)
    FROM chapters C
    JOIN history H ON C._id = H.chapter_id
    WHERE C.manga_id = mangas._id
);
